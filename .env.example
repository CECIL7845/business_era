# Copy to .env (local) or set in your host's secret manager. NEVER commit real values.

# PostgreSQL connection (use the managed provider's pooled URL in production, with sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/businestra_dev?schema=public"
# Only for automated tests — database name MUST contain "test"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/businestra_test?schema=public"
DATABASE_POOL_MAX=10

# Public base URL (used in emails and Paystack callback). No trailing slash.
APP_URL="http://localhost:3000"
APP_VERSION="dev"

# Transactional email via SMTP (Resend, Brevo, Mailgun, Zoho...). Leave empty in dev to print emails to the console.
# Format: smtps://USER:PASS@smtp.example.com:465
SMTP_URL=""
EMAIL_FROM="Businestra <no-reply@yourdomain.com>"

# Paystack (https://dashboard.paystack.com/#/settings/developers). Start with sk_test_...
PAYSTACK_SECRET_KEY=""
# Optional override, e.g. for a mock server
# PAYSTACK_BASE_URL="https://api.paystack.co"

# Daily job auth (POST /api/cron/daily with "Authorization: Bearer $CRON_SECRET"); 32+ random chars
CRON_SECRET=""

# Shown on Help pages (public)
NEXT_PUBLIC_SUPPORT_EMAIL="support@yourdomain.com"
NEXT_PUBLIC_SUPPORT_WHATSAPP="+233XXXXXXXXX"

# Seeding (npm run db:seed)
# SEED_ADMIN_EMAIL="you@yourdomain.com"
# SEED_ADMIN_PASSWORD=""
# SEED_DEMO=1   # development only
